# Trading project environment template
# 실제 키/계좌/DATABASE_URL은 .env에만 넣고 Git에 올리지 마세요.

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_PROJECT_REF=your-project-ref
DATABASE_URL=postgresql://postgres.your-project-ref:***@aws-0-region.pooler.supabase.com:6543/postgres

# Kiwoom trading environment: mock | prod
TRADING_ENV=mock

# Kiwoom mock credentials
KIWOOM_REST_API_KEY_MOCK=your-mock-api-key
KIWOOM_REST_API_SECRET_MOCK=your-mock-api-secret
KIWOOM_ACCOUNT_NO_MOCK=your-mock-account-no

# Kiwoom production credentials
KIWOOM_REST_API_KEY_PROD=your-prod-api-key
KIWOOM_REST_API_SECRET_PROD=your-prod-api-secret
KIWOOM_ACCOUNT_NO_PROD=your-prod-account-no

# Optional OpenDART
OPENDART_API_KEY=your-opendart-api-key
